{
  "name": "@oribos/background-tasks",
  "version": "0.9.0",
  "description": "Oribos background-tasks capability package — application-owned background work as task rows: submit → lease → in-process execution → heartbeat → settle, with adopt() re-running orphans and untilIdle() as a package-level wait. In-memory store and lease defaults ship zero-dependency; any Redis-compatible client rides the lease's structural subset. No @oribos/core peer — the types are self-contained.",
  "keywords": [
    "ai-agents",
    "llm",
    "typescript",
    "agent-framework",
    "background-tasks",
    "leases",
    "task-execution"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:dist": "node ../../scripts/check-dist.mjs",
    "check:export-surface": "node ../../scripts/check-export-surface.mjs",
    "check:runtime-deps": "node ../../scripts/check-runtime-deps.mjs",
    "check:byte-budget": "node ../../scripts/check-byte-budget.mjs",
    "byte-budget:update": "node ../../scripts/check-byte-budget.mjs --update",
    "check:deps-budget": "node ../../scripts/check-deps-budget.mjs",
    "deps-budget:update": "node ../../scripts/check-deps-budget.mjs --update",
    "prepublishOnly": "pnpm -w verify"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xnicholas/oribos-framework.git",
    "directory": "packages/background-tasks"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@oribos/core": "workspace:*",
    "@oribos/testing": "workspace:*"
  }
}
