{
  "name": "@oribos/otlp",
  "version": "0.6.0",
  "description": "Oribos OTLP exporter — spans to GenAI semconv shape over OTLP/HTTP (protobuf or JSON), official OpenTelemetry exporter stack underneath.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:dist": "node ../../scripts/check-dist.mjs",
    "check:export-surface": "node ../../scripts/check-export-surface.mjs",
    "check:runtime-deps": "node ../../scripts/check-runtime-deps.mjs",
    "check:byte-budget": "node ../../scripts/check-byte-budget.mjs",
    "byte-budget:update": "node ../../scripts/check-byte-budget.mjs --update",
    "check:deps-budget": "node ../../scripts/check-deps-budget.mjs",
    "deps-budget:update": "node ../../scripts/check-deps-budget.mjs --update",
    "prepublishOnly": "pnpm -w verify"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xnicholas/oribos-framework.git",
    "directory": "packages/otlp"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@oribos/core": "workspace:^"
  },
  "devDependencies": {
    "@oribos/core": "workspace:*"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace": "2.11.0"
  }
}
