{
  "name": "@oribos/inngest",
  "version": "0.9.0",
  "description": "Oribos inngest capability package — trigger-level durable execution: workflow start/resume ride Inngest trigger events, the walker and snapshot store stay in process (the snapshot remains the state truth), a crashed run is continued by the engine's retry re-entering from its snapshot. No dependency beyond the @oribos/core peer and an exact-pinned inngest.",
  "keywords": [
    "ai-agents",
    "llm",
    "typescript",
    "agent-framework",
    "workflow",
    "durable-execution",
    "inngest"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:dist": "node ../../scripts/check-dist.mjs",
    "check:export-surface": "node ../../scripts/check-export-surface.mjs",
    "check:runtime-deps": "node ../../scripts/check-runtime-deps.mjs",
    "check:byte-budget": "node ../../scripts/check-byte-budget.mjs",
    "byte-budget:update": "node ../../scripts/check-byte-budget.mjs --update",
    "check:deps-budget": "node ../../scripts/check-deps-budget.mjs",
    "deps-budget:update": "node ../../scripts/check-deps-budget.mjs --update",
    "prepublishOnly": "pnpm -w verify"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xnicholas/oribos-framework.git",
    "directory": "packages/inngest"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@oribos/core": "workspace:^"
  },
  "devDependencies": {
    "@oribos/core": "workspace:*",
    "@oribos/testing": "workspace:*"
  },
  "dependencies": {
    "inngest": "4.24.0"
  }
}
