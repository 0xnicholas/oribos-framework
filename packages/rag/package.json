{
  "name": "@oribos/rag",
  "version": "0.8.0",
  "description": "Oribos RAG capability package — semantic recall over message history: wrap a MemoryStore to index saved messages with your embedding model and pull older relevant messages back into the recall window, no dependencies beyond the @oribos/core peer.",
  "keywords": [
    "ai-agents",
    "llm",
    "typescript",
    "agent-framework",
    "rag",
    "semantic-recall",
    "embeddings",
    "memory"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:dist": "node ../../scripts/check-dist.mjs",
    "check:export-surface": "node ../../scripts/check-export-surface.mjs",
    "check:runtime-deps": "node ../../scripts/check-runtime-deps.mjs",
    "check:byte-budget": "node ../../scripts/check-byte-budget.mjs",
    "byte-budget:update": "node ../../scripts/check-byte-budget.mjs --update",
    "check:deps-budget": "node ../../scripts/check-deps-budget.mjs",
    "deps-budget:update": "node ../../scripts/check-deps-budget.mjs --update",
    "prepublishOnly": "pnpm -w verify"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xnicholas/oribos-framework.git",
    "directory": "packages/rag"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@oribos/core": "workspace:^"
  },
  "devDependencies": {
    "@oribos/core": "workspace:*",
    "@oribos/testing": "workspace:*",
    "zod": "^4.6.5"
  }
}
