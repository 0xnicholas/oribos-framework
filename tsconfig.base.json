{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@oribos/core": ["./packages/core/src/index.ts"],
      "@oribos/core/*": ["./packages/core/src/*/index.ts"],
      "@oribos/ai-sdk": ["./packages/ai-sdk/src/index.ts"],
      "@oribos/checkpoints": ["./packages/checkpoints/src/index.ts"],
      "@oribos/croner": ["./packages/croner/src/index.ts"],
      "@oribos/distributed-signals": ["./packages/distributed-signals/src/index.ts"],
      "@oribos/evals": ["./packages/evals/src/index.ts"],
      "@oribos/inngest": ["./packages/inngest/src/index.ts"],
      "@oribos/mcp-client": ["./packages/mcp-client/src/index.ts"],
      "@oribos/mcp-server": ["./packages/mcp-server/src/index.ts"],
      "@oribos/model-router": ["./packages/model-router/src/index.ts"],
      "@oribos/observational-memory": ["./packages/observational-memory/src/index.ts"],
      "@oribos/otel-bridge": ["./packages/otel-bridge/src/index.ts"],
      "@oribos/otlp": ["./packages/otlp/src/index.ts"],
      "@oribos/rag": ["./packages/rag/src/index.ts"],
      "@oribos/resumable-stream": ["./packages/resumable-stream/src/index.ts"],
      "@oribos/semconv": ["./packages/semconv/src/index.ts"],
      "@oribos/sqlite": ["./packages/sqlite/src/index.ts"],
      "@oribos/supervisor": ["./packages/supervisor/src/index.ts"],
      "@oribos/testing": ["./packages/testing/src/index.ts"]
    },
    "noEmit": true
  }
}
